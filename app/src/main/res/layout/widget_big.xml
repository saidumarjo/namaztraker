<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_stat_gold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="НАМОЗХОН TJ"
            android:textColor="#F2F7F4"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#9AB0A7"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_head"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Намози навбатӣ"
                android:textColor="#9AB0A7"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/w_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="НАМОЗХОН TJ"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_next_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Барномаро як бор кушоед"
                android:textColor="#B9CCC3"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <Chronometer
                android:id="@+id/w_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B8F07E"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_cnt_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="то оғоз"
                android:textColor="#9AB0A7"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/w_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:id="@+id/w_n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F2F7F4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9CCC3"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_s0"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/w_st_none"
                android:gravity="center"
                android:textColor="#0F1F0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/w_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:id="@+id/w_n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F2F7F4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9CCC3"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_s1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/w_st_none"
                android:gravity="center"
                android:textColor="#0F1F0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/w_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:id="@+id/w_n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F2F7F4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9CCC3"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_s2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/w_st_none"
                android:gravity="center"
                android:textColor="#0F1F0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/w_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:id="@+id/w_n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F2F7F4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9CCC3"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_s3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/w_st_none"
                android:gravity="center"
                android:textColor="#0F1F0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/w_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">
            <TextView
                android:id="@+id/w_n4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#F2F7F4"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B9CCC3"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_s4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/w_st_none"
                android:gravity="center"
                android:textColor="#0F1F0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
